# LLM provider — set one of these:
# Option A: Google Gemini (free tier via AI Studio, recommended)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# Option B: OpenRouter (paid credits)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Playwright browser agent config
BROWSER_HEADLESS=true
AMAZON_DOMAIN=https://www.amazon.ca

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
